generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           String   @id @default(cuid())
  login        String   @unique
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  save         Save?
}

model Save {
  id           String             @id @default(cuid())
  usuarioId    String             @unique
  nomeTreinador String
  moedas       Int                @default(0)
  fichas       Int                @default(0)
  vitorias     Int                @default(0)
  derrotas     Int                @default(0)
  iniciadoEm   DateTime?
  inicialEspecieId Int?
  criadoEm     DateTime           @default(now())
  atualizadoEm DateTime           @updatedAt
  usuario      Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pokemons     PokemonCapturado[]
  inventario   ItemInventario[]
  batalhas     Batalha[]
  desafios     DesafioConcluido[]
  especiesRegistradas EspecieRegistrada[]
  eventos      BatalhaEvento[]
  missoesResgatadas MissaoResgatada[]
  cassinoRodada CassinoRodada?
  lojaPokemonEstoque LojaPokemonEstoque?
  kitEntregue  Boolean @default(false)
  equipes      String  @default("[]")
}

// especieId referencia o catalogo local (1 a 1025).
// Campo legado preservado para saves antigos; a colecao nao tem limite de membros.
model PokemonCapturado {
  id            String   @id @default(cuid())
  saveId        String
  especieId     Int
  apelido       String?
  nivel         Int      @default(5)
  experiencia   Int      @default(0)
  hpAtual       Int
  shiny         Boolean  @default(false)
  bolaCaptura   String?
  sexo          String?
  amizade       Int      @default(70)
  investimentoItens Int  @default(0)
  favorito      Boolean  @default(false)
  megaForma     String?
  gmaxForma     String?
  atributos     Json?
  ivs           Json     @default("{\"hp\":15,\"attack\":15,\"defense\":15,\"special-attack\":15,\"special-defense\":15,\"speed\":15}")
  golpes        Json?
  golpesDesbloqueados Json?
  posicaoTime   Int?
  capturadoEm   DateTime @default(now())
  save          Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@unique([saveId, posicaoTime])
  @@index([saveId, especieId])
}

model GolpeBatalha {
  id        Int    @id
  nome      String @unique
  tipo      String
  categoria String
  poder     Int
  precisao  Int?
  prioridade Int  @default(0)
  especies  EspecieAtaque[]
}

model EspecieAtaque {
  especieId Int
  posicao   Int
  golpeId   Int
  nivelAprendido Int @default(1)
  golpe     GolpeBatalha @relation(fields: [golpeId], references: [id])

  @@id([especieId, posicao])
  @@unique([especieId, golpeId])
}

model Batalha {
  id        String   @id @default(cuid())
  saveId    String   @unique
  versao    Int      @default(0)
  estado    Json
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
}

model DesafioConcluido {
  saveId    String
  desafioId String
  vencidoEm DateTime @default(now())
  save      Save @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@id([saveId, desafioId])
}

model EspecieRegistrada {
  saveId String
  especieId Int
  save Save @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@id([saveId, especieId])
}

model ItemInventario {
  id         String @id @default(cuid())
  saveId     String
  itemId     String
  quantidade Int    @default(0)
  save       Save   @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@unique([saveId, itemId])
}

model CassinoRodada {
  saveId    String   @id
  estado    Json
  criadoEm  DateTime @default(now())
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
}

model LojaPokemonEstoque {
  saveId    String   @id
  periodo   Int
  estado    Json
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)
}

model BatalhaEvento {
  id          String   @id @default(cuid())
  saveId      String
  tipo        String
  especieId   Int?
  regiao      String?
  dificuldade String?
  torneioId   String?
  resultado   String?
  descricao   String
  shiny       Boolean  @default(false)
  criadoEm    DateTime @default(now())
  save        Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@index([saveId, criadoEm])
  @@index([saveId, tipo, regiao, criadoEm])
}

model MissaoResgatada {
  id        String   @id @default(cuid())
  saveId    String
  periodo   Int
  indice    Int
  criadoEm  DateTime @default(now())
  save      Save     @relation(fields: [saveId], references: [id], onDelete: Cascade)

  @@unique([saveId, periodo, indice])
}
