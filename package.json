{
  "name": "pokemon-simulator",
  "version": "0.5.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node scripts/start-game.js",
    "release:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
    "release:publish": "node scripts/publish-release.js",
    "sprites:download": "node scripts/download-sprites.js",
    "test": "node --test scripts/test/*.test.js"
  }
}
